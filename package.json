{
    "name": "kardux-battle",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "A real-time, multiplayer Top Trumps-style card battle game.",
    "license": "MIT",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.17.0",
    "scripts": {
        "build": "turbo run build",
        "dev": "node scripts/dev.mjs",
        "dev:api": "pnpm --filter @kardux/api dev",
        "dev:web": "pnpm --filter @kardux/web dev",
        "redis": "redis-server --port 6379 --bind 127.0.0.1 --dir .redis --appendonly yes",
        "build:packages": "pnpm --filter ./packages/* build",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint -- --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.5.0",
        "@commitlint/config-conventional": "^19.5.0",
        "@eslint/js": "^9.13.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.13.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "husky": "^9.1.6",
        "lint-staged": "^15.2.10",
        "prettier": "^3.3.3",
        "turbo": "^2.2.3",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.11.0",
        "vitest": "^2.1.4"
    },
    "lint-staged": {
        "*.{ts,tsx,js}": [
            "eslint --fix"
        ],
        "*.{ts,tsx,js,json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
