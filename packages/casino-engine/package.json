{
    "name": "@kardux/casino-engine",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Pure, deterministic casino game rules: Blackjack and Texas Hold'em.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@kardux/contracts": "workspace:*",
        "@kardux/engine": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^5.6.3",
        "vitest": "^2.1.4"
    }
}
