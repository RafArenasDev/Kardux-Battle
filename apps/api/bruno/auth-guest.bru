meta {
  name: Create guest identity
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/guest
  body: json
  auth: none
}

body:json {
  {
    "nickname": "RafArenas",
    "avatarSeed": "RafArenas",
    "tabId": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
  }
}

docs {
  Issues a guest JWT for a brand-new player (no account, no password). Call once per
  browser tab; keep the returned `token` and the `tabId` you sent in sessionStorage.
  `tabId` should be a fresh UUID per tab - reusing the sample one is fine for manual
  testing, but each real tab must generate its own with crypto.randomUUID().
}
