{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "allowJs": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src"]
}
