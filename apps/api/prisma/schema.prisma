// docs/SPEC.md's "BASE DE DATOS" section, as a real Prisma schema.
//
// Provider is fixed to postgresql, not switched via DATABASE_PROVIDER: Prisma has to know
// the connector at `generate` time to produce the right client code, so a schema can't
// conditionally pick postgresql-vs-sqlite from an env var at runtime - only the connection
// URL can come from env. Supporting sqlite for dev would mean maintaining a second schema
// file and swapping which one `generate`/`migrate` reads; not worth it while this project's
// dev machine already has real Postgres (ADR 0004). `DATABASE_PROVIDER` in `.env` stays
// documentation of intent for now, not something this file reads.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A guest identity (docs/SPEC.md: "Auth: JWT de invitado (nickname + tabId)"). Created on
/// first `POST /auth/guest`, not tied to a password by default. `username`/`passwordHash`
/// are optional: `POST /auth/register` can "claim" an existing guest
/// row by setting both, keeping the same `id` so hostedMatches/matchPlayers/leaderboardStat
/// survive the tab closing; `POST /auth/login` then mints a fresh JWT for that same `id`.
model Player {
  id           String   @id @default(cuid())
  nickname     String
  avatarSeed   String
  username     String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  hostedMatches   Match[]         @relation("MatchHost")
  matchPlayers    MatchPlayer[]
  leaderboardStat LeaderboardStat?

  @@index([nickname])

  @@map("players")
}

enum MatchStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}

/// One playthrough. `config`/`winnerId` mirror `@kardux/contracts`'s `MatchConfig`/
/// `MatchState.winnerId` - this row is the durable record of a match that otherwise lives
/// as in-memory `MatchState` while it's actually being played (`MatchRuntimeService`)
/// plus a `DeckSnapshot`/`MatchEvent` trail for replay.
model Match {
  id        String      @id @default(cuid())
  /// 6-character hex room code. Not globally unique in the schema on purpose: docs/SPEC.md
  /// calls for uniqueness only "sobre partidas activas" (a finished match's code can be
  /// reused later) - Prisma's declarative schema can't express a partial/filtered unique
  /// index, so that rule is enforced in `MatchService` (a new room never gets a code already
  /// held by another LOBBY/IN_PROGRESS match) rather than at the DB level.
  code      String
  config    Json
  status    MatchStatus @default(LOBBY)
  seed      String
  hostId    String
  host      Player        @relation("MatchHost", fields: [hostId], references: [id])
  startedAt DateTime?
  endedAt   DateTime?
  winnerId  String?
  isDraw    Boolean     @default(false)
  /// Set once the post-match Elo update has run, so a retried rating job never applies the
  /// same result twice.
  ratedAt   DateTime?
  createdAt DateTime    @default(now())

  players      MatchPlayer[]
  rounds       Round[]
  deckSnapshot DeckSnapshot?
  events       MatchEvent[]

  @@index([code])
  @@index([status])

  @@map("matches")
}

/// Lifecycle of a `MatchPlayer` row across the two join flows `GameGateway` supports
/// (docs/SPEC.md "CONTRATO DE EVENTOS SOCKET.IO" + "Solicitudes de ingreso"): a
/// direct `match:join` (by code/deep link) is auto-`APPROVED`, a discovery `match:requestJoin`
/// (from `GET /matches/public`, no code) starts `PENDING` until the host calls
/// `match:respondJoin`. Rows are never deleted on rejection - kept `REJECTED` for audit/history.
enum MatchPlayerStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A user's participation in one match - the durable counterpart of `@kardux/contracts`'s
/// `Player`, minus everything that only matters while the match is live (cards, connection
/// state).
model MatchPlayer {
  id            String            @id @default(cuid())
  matchId       String
  match         Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId        String
  user          Player              @relation(fields: [userId], references: [id])
  seat          Int
  joinOrder     Int
  /// Defaults to `APPROVED` so the pre-existing direct-join behavior (and any caller that
  /// doesn't know about the request-join flow yet) is unaffected. Capacity checks
  /// (`maxPlayers`) only ever count `APPROVED` rows.
  status        MatchPlayerStatus @default(APPROVED)
  finalCards    Int?
  placement     Int?
  eliminatedAt  DateTime?

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([matchId, status])

  @@map("match_players")
}

/// One resolved round. `leaderId`/`winnerId` reference `Player.id` (the durable identity),
/// not the engine's opaque per-session player id - a round's leader/winner still make sense
/// to query long after the socket session that produced them is gone.
model Round {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  index       Int
  attribute   String
  leaderId    String
  winnerId    String?
  isTie       Boolean  @default(false)
  potSize     Int
  playedCards Json
  createdAt   DateTime @default(now())

  @@unique([matchId, index])

  @@map("rounds")
}

/// The built deck for a match, persisted once at creation so the match stays playable and
/// reproducible even if the source API (or, once ADR 0006 lands, the CardPoolEntry mirror)
/// changes underneath it mid-match.
model DeckSnapshot {
  id      String @id @default(cuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  cards   Json

  @@map("deck_snapshots")
}

/// Global stats, one row per user - docs/SPEC.md's "TABLA DE POSICIONES": Elo (K=32, base
/// 1200) and aggregate counters.
model LeaderboardStat {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              Player     @relation(fields: [userId], references: [id])
  elo               Int      @default(1200)
  gamesPlayed       Int      @default(0)
  wins              Int      @default(0)
  losses            Int      @default(0)
  draws             Int      @default(0)
  streak            Int      @default(0)
  roundsWon         Int      @default(0)
  cardsWonTotal     Int      @default(0)
  favoriteAttribute String?
  updatedAt         DateTime @updatedAt

  @@index([elo(sort: Desc)])

  @@map("leaderboard_stats")
}

/// Append-only log of everything that happened in a match, for replays/debugging - never
/// updated or deleted once written.
model MatchEvent {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([matchId, createdAt])

  @@map("match_events")
}

/// Local mirror of the cards synced from PokéAPI (ADR 0006): queried once when the API boots
/// (and re-synced weekly), then every match is built from these rows - never from the network.
model CardPoolEntry {
  id         String   @id @default(cuid())
  source     String
  externalId String
  /// Quartet family: the Pokémon's primary type.
  quartetKey String
  name       String
  /// English name when the source provides one (`name` is the Spanish name).
  nameEn     String?
  imageUrl   String
  stats      Json
  syncedAt   DateTime @default(now())

  @@unique([source, externalId])
  @@index([source, quartetKey])

  @@map("card_pool_entries")
}
