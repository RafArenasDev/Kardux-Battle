# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL via Prisma) ---
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kardux_dev
# Assembled from the vars above by prisma/schema config; kept explicit here for clarity.
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"
DATABASE_PROVIDER=postgresql

# --- Redis (cache, per-room lock, Socket.IO adapter) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Guest JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme
JWT_GUEST_TTL=12h

# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100


# --- Free-tier data retention (hourly cleanup job) ---
RETENTION_FINISHED_DAYS=7
RETENTION_EVENTS_DAYS=2

# --- Deck kill switch: comma-separated ids to hide, e.g. DISABLED_DECKS=pokeapi ---
DISABLED_DECKS=
